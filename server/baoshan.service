[Unit]
Description=宝山学习群岛 Flask 服务
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/baoshan/server
EnvironmentFile=/opt/baoshan/server/.env
ExecStart=/usr/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
