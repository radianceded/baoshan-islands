* text=auto eol=lf

# Windows command scripts keep CRLF when checked out.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and runtime data must never be line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.webm binary
*.xls binary
*.xlsx binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
